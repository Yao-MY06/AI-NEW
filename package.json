{
  "name": "ainew",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI 新闻聚合器：抓取 RSS 源，AI 总结要点，输出 Markdown 日报",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "admin": "tsx src/admin.ts",
    "test": "vitest run",
    "db:check": "tsx scripts/db-check.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.5",
    "linkedom": "^0.18.9",
    "openai": "^6.0.0",
    "rss-parser": "^3.13.0",
    "undici": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7"
  }
}
