# ===== 主模型（OpenAI 兼容接口，必填才生成 AI 摘要）=====

OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# PROVIDER_NAME=智谱GLM          # 日志里显示的名称（可选）

# 示例 - 智谱:
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_MODEL=glm-4-flash       # 免费

# 示例 - DeepSeek:
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# ===== 备用模型（可选，主模型失败自动按序切换，连续失败 3 次本轮停用）=====

# FALLBACK_1_API_KEY=sk-xxxx
# FALLBACK_1_BASE_URL=https://api.deepseek.com/v1
# FALLBACK_1_MODEL=deepseek-chat

# 本地 Ollama 示例（Key 随便填非空值即可）:
# FALLBACK_2_API_KEY=ollama
# FALLBACK_2_BASE_URL=http://localhost:11434/v1
# FALLBACK_2_MODEL=qwen2.5:7b

# ===== 摘要模板 =====

# SUMMARY_TEMPLATE=tech          # tech=技术简报 / security=风险安全专刊（安全视角+安全类关键词自动置顶）
# SUMMARY_STYLE=brief            # brief=精简(2~3条要点) / detailed=详细(4~6条)
# SUMMARY_VERDICT=true           # false 则不生成点评

# 关注关键词：命中的文章置顶并加 ★ 标记（逗号分隔，中英文请分别列出）
# PIN_KEYWORDS=芯片,FPGA,多模态,chip,FPGA,multimodal
# 黑名单关键词：命中的文章直接不出现在日报里
# BLOCK_KEYWORDS=招聘,giveaway,newsletter

# ===== 网络代理（可选，RSS 与 AI 请求都会走它）=====
# HTTPS_PROXY=http://127.0.0.1:7890
